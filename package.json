{
  "name": "soccerquiz",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz des clubs de Coupe du monde — site statique, sans étape de build.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "validate": "python3 tools/validate.py",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
